{
  "brew": [
    {"id": "caddy", "name": "Caddy", "desc": "Modern web server / reverse proxy with automatic HTTPS (the Sites module depends on it)", "pkg": "caddy", "ports": [80, 443], "service": "caddy"},
    {"id": "nginx", "name": "Nginx", "desc": "High-performance web server and reverse proxy", "pkg": "nginx", "ports": [80], "service": "nginx"},
    {"id": "redis", "name": "Redis", "desc": "In-memory database / cache", "pkg": "redis", "ports": [6379], "service": "redis"},
    {"id": "postgresql", "name": "PostgreSQL", "desc": "Relational database", "pkg": "postgresql@17", "ports": [5432], "service": "postgresql@17"},
    {"id": "mysql", "name": "MySQL", "desc": "Relational database", "pkg": "mysql", "ports": [3306], "service": "mysql"},
    {"id": "mariadb", "name": "MariaDB", "desc": "MySQL-compatible fork", "pkg": "mariadb", "ports": [3306], "service": "mariadb"},
    {"id": "memcached", "name": "Memcached", "desc": "Distributed in-memory cache", "pkg": "memcached", "ports": [11211], "service": "memcached"},
    {"id": "php", "name": "PHP", "desc": "PHP runtime (needed by WordPress and similar sites)", "pkg": "php", "ports": [9000], "service": ""},
    {"id": "node", "name": "Node.js", "desc": "JavaScript runtime", "pkg": "node", "ports": [], "service": ""},
    {"id": "ollama", "name": "Ollama", "desc": "Local LLM runtime (self-hosted AI)", "pkg": "ollama", "ports": [11434], "service": "ollama"},
    {"id": "syncthing", "name": "Syncthing", "desc": "Open-source continuous file sync", "pkg": "syncthing", "ports": [8384], "service": "syncthing"},
    {"id": "frp", "name": "frp", "desc": "Reverse proxy / NAT traversal tool", "pkg": "frpc", "ports": [], "service": ""},
    {"id": "cloudflared", "name": "cloudflared", "desc": "Cloudflare Tunnel client", "pkg": "cloudflared", "ports": [], "service": "cloudflared"},
    {"id": "rclone", "name": "rclone", "desc": "Cloud storage utility (rsync for cloud providers)", "pkg": "rclone", "ports": [], "service": ""},
    {"id": "ffmpeg", "name": "FFmpeg", "desc": "Audio/video processing toolkit", "pkg": "ffmpeg", "ports": [], "service": ""},
    {"id": "gitea", "name": "Gitea (brew)", "desc": "Lightweight self-hosted Git service", "pkg": "gitea", "ports": [3000], "service": "gitea"}
  ],
  "container": [
    {"id": "uptime-kuma", "name": "Uptime Kuma", "desc": "Self-hosted uptime monitoring", "image": "docker.m.daocloud.io/louislam/uptime-kuma:latest", "ports": [3001], "run_args": ["-p", "3001:3001", "-v", "$HOME/macpanel/data/kuma:/app/data"]},
    {"id": "minio", "name": "MinIO", "desc": "S3-compatible object storage", "image": "docker.m.daocloud.io/minio/minio:latest", "ports": [9001, 9002], "run_args": ["-p", "9001:9000", "-p", "9002:9001", "-v", "$HOME/macpanel/data/minio:/data"]},
    {"id": "gitea", "name": "Gitea", "desc": "Lightweight self-hosted Git service", "image": "docker.m.daocloud.io/gitea/gitea:latest", "ports": [3100, 3122], "run_args": ["-p", "3100:3000", "-p", "3122:22", "-v", "$HOME/macpanel/data/gitea:/data"]},
    {"id": "n8n", "name": "n8n", "desc": "Workflow automation", "image": "docker.m.daocloud.io/n8nio/n8n:latest", "ports": [5678], "run_args": ["-p", "5678:5678", "-v", "$HOME/macpanel/data/n8n:/home/node/.n8n"]},
    {"id": "nginx", "name": "Nginx (container)", "desc": "Isolated nginx instance", "image": "docker.m.daocloud.io/library/nginx:latest", "ports": [8088], "run_args": ["-p", "8088:80"]},
    {"id": "redis", "name": "Redis (container)", "desc": "Isolated redis instance", "image": "docker.m.daocloud.io/library/redis:latest", "ports": [6390], "run_args": ["-p", "6390:6379"]},
    {"id": "postgres", "name": "PostgreSQL (container)", "desc": "Isolated PostgreSQL instance", "image": "docker.m.daocloud.io/library/postgres:17", "ports": [5433], "run_args": ["-p", "5433:5432", "-v", "$HOME/macpanel/data/pg:/var/lib/postgresql/data"]},
    {"id": "memos", "name": "Memos", "desc": "Lightweight note-taking (flomo alternative)", "image": "docker.m.daocloud.io/neosmemo/memos:latest", "ports": [5230], "run_args": ["-p", "5230:5230", "-v", "$HOME/macpanel/data/memos:/var/opt/memos"]}
  ]
}
