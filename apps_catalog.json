{
  "brew": [
    {"id": "caddy", "name": "Caddy", "desc": "现代 web 服务器/反向代理,自动 HTTPS(网站管理模块依赖)", "pkg": "caddy", "ports": [80, 443], "service": "caddy"},
    {"id": "nginx", "name": "Nginx", "desc": "高性能 web 服务器与反向代理(宝塔主力)", "pkg": "nginx", "ports": [80], "service": "nginx"},
    {"id": "redis", "name": "Redis", "desc": "内存数据库/缓存(宝塔、1Panel 常备)", "pkg": "redis", "ports": [6379], "service": "redis"},
    {"id": "postgresql", "name": "PostgreSQL", "desc": "关系型数据库(1Panel 主力)", "pkg": "postgresql@17", "ports": [5432], "service": "postgresql@17"},
    {"id": "mysql", "name": "MySQL", "desc": "关系型数据库(宝塔主力)", "pkg": "mysql", "ports": [3306], "service": "mysql"},
    {"id": "mariadb", "name": "MariaDB", "desc": "MySQL 兼容分支", "pkg": "mariadb", "ports": [3306], "service": "mariadb"},
    {"id": "memcached", "name": "Memcached", "desc": "分布式内存缓存(宝塔/1Panel 常备)", "pkg": "memcached", "ports": [11211], "service": "memcached"},
    {"id": "php", "name": "PHP", "desc": "PHP 运行时(WordPress 等站点需要)", "pkg": "php", "ports": [9000], "service": ""},
    {"id": "node", "name": "Node.js", "desc": "JavaScript 运行时", "pkg": "node", "ports": [], "service": ""},
    {"id": "ollama", "name": "Ollama", "desc": "本地大模型运行时(AI 自托管)", "pkg": "ollama", "ports": [11434], "service": "ollama"},
    {"id": "syncthing", "name": "Syncthing", "desc": "开源文件同步(1Panel 商店同款)", "pkg": "syncthing", "ports": [8384], "service": "syncthing"},
    {"id": "frp", "name": "frp", "desc": "内网穿透工具", "pkg": "frpc", "ports": [], "service": ""},
    {"id": "cloudflared", "name": "cloudflared", "desc": "Cloudflare Tunnel 客户端(本机已在用)", "pkg": "cloudflared", "ports": [], "service": "cloudflared"},
    {"id": "rclone", "name": "rclone", "desc": "云存储工具(本机 WebDAV 已在用)", "pkg": "rclone", "ports": [], "service": ""},
    {"id": "ffmpeg", "name": "FFmpeg", "desc": "音视频处理工具", "pkg": "ffmpeg", "ports": [], "service": ""},
    {"id": "gitea", "name": "Gitea (brew)", "desc": "轻量 Git 服务(1Panel 商店同款)", "pkg": "gitea", "ports": [3000], "service": "gitea"}
  ],
  "container": [
    {"id": "uptime-kuma", "name": "Uptime Kuma", "desc": "自托管监控面板(1Panel 热门)", "image": "docker.m.daocloud.io/louislam/uptime-kuma:latest", "ports": [3001], "run_args": ["-p", "3001:3001", "-v", "$HOME/macpanel/data/kuma:/app/data"]},
    {"id": "minio", "name": "MinIO", "desc": "S3 兼容对象存储(1Panel 常备)", "image": "docker.m.daocloud.io/minio/minio:latest", "ports": [9001, 9002], "run_args": ["-p", "9001:9000", "-p", "9002:9001", "-v", "$HOME/macpanel/data/minio:/data"]},
    {"id": "gitea", "name": "Gitea", "desc": "轻量 Git 服务", "image": "docker.m.daocloud.io/gitea/gitea:latest", "ports": [3100, 3122], "run_args": ["-p", "3100:3000", "-p", "3122:22", "-v", "$HOME/macpanel/data/gitea:/data"]},
    {"id": "n8n", "name": "n8n", "desc": "自动化工作流(1Panel 热门)", "image": "docker.m.daocloud.io/n8nio/n8n:latest", "ports": [5678], "run_args": ["-p", "5678:5678", "-v", "$HOME/macpanel/data/n8n:/home/node/.n8n"]},
    {"id": "nginx", "name": "Nginx 容器版", "desc": "隔离的 nginx 实例", "image": "docker.m.daocloud.io/library/nginx:latest", "ports": [8088], "run_args": ["-p", "8088:80"]},
    {"id": "redis", "name": "Redis 容器版", "desc": "隔离的 redis 实例", "image": "docker.m.daocloud.io/library/redis:latest", "ports": [6390], "run_args": ["-p", "6390:6379"]},
    {"id": "postgres", "name": "PostgreSQL 容器版", "desc": "隔离的 PG 实例", "image": "docker.m.daocloud.io/library/postgres:17", "ports": [5433], "run_args": ["-p", "5433:5432", "-v", "$HOME/macpanel/data/pg:/var/lib/postgresql/data"]},
    {"id": "memos", "name": "Memos", "desc": "轻量笔记/flomo 替代", "image": "docker.m.daocloud.io/neosmemo/memos:latest", "ports": [5230], "run_args": ["-p", "5230:5230", "-v", "$HOME/macpanel/data/memos:/var/opt/memos"]}
  ]
}
